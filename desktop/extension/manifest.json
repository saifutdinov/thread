{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "default_locale": "en",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.example.org/*"
      ],
      "js": [
        "origins.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
