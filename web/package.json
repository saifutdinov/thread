{
  "name": "thread-web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-audio.mjs",
    "prebuild": "node scripts/build-audio.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/brotli.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/lib/*.test.ts",
    "test:proxy": "node --experimental-strip-types --no-warnings --test scripts/proxy.test.ts",
    "test:mic": "node scripts/build-audio.mjs && node scripts/test-microphone.mjs",
    "test:stream-volume": "node scripts/test-stream-volume.mjs",
    "test:fullscreen": "node --experimental-strip-types --no-warnings scripts/test-fullscreen.mjs",
    "test:calls:setup": "node scripts/install-livekit.mjs",
    "test:calls": "node scripts/call-failures.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@preact/signals": "2.11.3",
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "@lofcz/deepfilternet-web": "0.1.0",
    "livekit-client": "2.23.0",
    "preact": "11.0.1",
    "unicode-emoji-json": "0.9.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": "22.15.0"
  },
  "packageManager": "npm@11.6.2"
}
